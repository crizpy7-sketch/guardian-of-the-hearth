# Shia & Co. storefront — environment variable NAMES only.
#
# APP_BUILD_STANDARD.md §9: never commit real values. Set these in the Vercel
# project settings (Project → Settings → Environment Variables).
#
# The app runs without any of these in a clearly-reported degraded mode:
# signups are accepted in memory and are NOT durably stored.

# Supabase project that holds subscriber + song-order data.
SHIA_SUPABASE_URL=
# Service role key. Server-side only — never expose to the browser.
SHIA_SUPABASE_SERVICE_KEY=

# Table names (defaults shown; override only if your schema differs).
SHIA_SUBSCRIBERS_TABLE=shia_subscribers
SHIA_SONG_ORDERS_TABLE=shia_song_orders

# Shared operator token gating /api/orders. When unset, order access is
# disabled entirely (fails closed) rather than defaulting open.
SHIA_CONSOLE_TOKEN=
