# Shia & Co. storefront — environment variable NAMES only.
#
# APP_BUILD_STANDARD.md §9: never commit real values. Set these in the Vercel
# project settings (Project → Settings → Environment Variables).
#
# The app runs without any of these in a clearly-reported degraded mode:
# signups are accepted in memory and are NOT durably stored.

# Supabase project that holds subscriber + song-order data.
SHIA_SUPABASE_URL=
# Service role key. Server-side only — never expose to the browser.
SHIA_SUPABASE_SERVICE_KEY=

# Table names (defaults shown; override only if your schema differs).
SHIA_SUBSCRIBERS_TABLE=shia_subscribers
SHIA_SONG_ORDERS_TABLE=shia_song_orders

# Shared operator token gating every /api/admin/* route and the Square invoice
# sync. When unset, admin access is disabled entirely (fails closed) rather than
# defaulting open. Surrounding whitespace is trimmed before comparison.
SHIA_CONSOLE_TOKEN=

# ---------------------------------------------------------------------------
# SQUARE — the boutique's real catalog, stock and payments.
# ---------------------------------------------------------------------------
# Without these the shop cannot sell: /api/products returns an empty catalog and
# /api/checkout refuses with 503. Everything else still serves.
#
# Get these from the Square Developer dashboard (developer.squareup.com):
#   Applications → your app → Credentials.
# Use the SANDBOX credentials first and leave SQUARE_ENVIRONMENT=sandbox until a
# test order has gone all the way through.

# Access token. A bearer credential for real money — server-side only, never
# in a browser file, never committed.
SQUARE_ACCESS_TOKEN=
# The location that holds stock and receives orders (Locations in the dashboard).
SQUARE_LOCATION_ID=
# sandbox | production. Defaults to sandbox, so a misconfiguration cannot write
# to a live boutique's catalog.
SQUARE_ENVIRONMENT=sandbox
# Square pins behaviour to a dated API version. Match what your Square dashboard
# reports for your application.
SQUARE_API_VERSION=2025-01-23

# Table holding reveal / experience box orders (see docs/schema.sql).
SHIA_REVEAL_TABLE=shia_reveal_orders
